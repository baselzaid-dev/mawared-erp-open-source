# Replace the example password with the password you set for your local role.
DATABASE_URL=postgresql://mawared_dev:replace-local-password@127.0.0.1:5432/mawared_dev?schema=public
DIRECT_URL=postgresql://mawared_dev:replace-local-password@127.0.0.1:5432/mawared_dev?schema=public
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate separate values using openssl rand -hex 32.
JWT_SECRET=
PLATFORM_JWT_SECRET=
# Generate with openssl rand -base64 32.
MFA_ENCRYPTION_KEY=
# Set a unique password of at least 20 bytes for the local demo admin.
MAWARED_DEV_SEED_PASSWORD=
