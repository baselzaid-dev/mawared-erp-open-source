# DATABASE_URL: Supabase transaction pooler on port 6543 with pgbouncer=true
DATABASE_URL="postgresql://user:pass@host:6543/db?pgbouncer=true"

# DIRECT_URL: Supabase session pooler on port 5432 for Prisma db push
DIRECT_URL="postgresql://user:pass@host:5432/db"

# JWT_SECRET: Secret key for signing JWT access tokens. Use a strong random string.
# MUST BE SET IN PRODUCTION.
JWT_SECRET="replace-with-a-strong-random-secret-before-running"

# NODE_ENV: "production" enables static serving, strict CORS, etc.
NODE_ENV="production"

# --- Auth hardening (all optional, safe defaults shown) ---
# Access-token lifetime (jsonwebtoken format). Default: 15m
ACCESS_TOKEN_TTL="15m"
# Refresh-token lifetime in days. Default: 7
REFRESH_TOKEN_TTL_DAYS="7"
# Login/refresh rate limit: window in milliseconds. Default: 900000 (15 minutes)
AUTH_RATE_LIMIT_WINDOW_MS="900000"
# Login/refresh rate limit: max attempts per IP per window. Default: 10
AUTH_RATE_LIMIT_MAX="10"
# Base64-encoded 32-byte AES key for TOTP secrets. Generate outside Git.
MFA_ENCRYPTION_KEY="<base64-encoded-32-byte-key>"
# Verification attempts per challenge/IP window. Default: 5
MFA_RATE_LIMIT_MAX="5"
# Separate Platform control-plane signing secret. Never reuse JWT_SECRET.
PLATFORM_JWT_SECRET="<strong-random-platform-signing-secret>"
PLATFORM_ACCESS_TOKEN_TTL="10m"
PLATFORM_REFRESH_TOKEN_TTL_DAYS="7"
PLATFORM_AUTH_RATE_LIMIT_MAX="10"
PLATFORM_PROVISION_RATE_LIMIT_WINDOW_MS="3600000"
PLATFORM_PROVISION_RATE_LIMIT_MAX="5"

# --- Credential recovery E1 (lazy; required only when recovery service is constructed) ---
# Dedicated HMAC pepper for recovery token digests. Never reuse JWT_SECRET / PLATFORM_JWT_SECRET / MFA_ENCRYPTION_KEY.
# CREDENTIAL_RECOVERY_TOKEN_PEPPER="<strong-random-recovery-token-pepper-min-32-chars>"
# Dedicated pepper for rate-limit bucket key hashing. Never reuse the token pepper.
# CREDENTIAL_RECOVERY_RATE_LIMIT_PEPPER="<strong-random-recovery-rate-limit-pepper-min-32-chars>"
# Server-derived environment binding: <class>:<fingerprint> where class is local|test|staging|production.
# CREDENTIAL_RECOVERY_ENVIRONMENT_BINDING="local:dev-fingerprint-example"

# --- Credential recovery E6 transactional email (commented placeholders only) ---
# Set protected values in the hosting provider; never commit a real provider key.
# RECOVERY_EMAIL_API_BASE_URL=""
# RECOVERY_EMAIL_API_KEY=""
# RECOVERY_EMAIL_FROM_ADDRESS=""
# RECOVERY_EMAIL_TIMEOUT_MS=""
# RECOVERY_EMAIL_DEFAULT_LOCALE=""
# RECOVERY_PLATFORM_CONSOLE_BASE_URL=""
# RECOVERY_COMPANY_OWNER_LINK_BASE_URL=""
# RECOVERY_EMAIL_ALLOWED_HOSTS=""
# RECOVERY_EMAIL_REQUIRE_PROVIDER=""

# --- CORS ---
# Comma-separated list of allowed browser origins.
# In production, leaving this UNSET denies all cross-origin browser requests
# (native Android is unaffected — it does not send an Origin header).
# CORS_ORIGINS="https://app.example.com,https://admin.example.com"

# --- AI (Gemini proxy) ---
# Server-side only. NEVER ship this key inside the Android app.
# If unset, POST /api/v1/ai/chat returns 503 (feature disabled).
# GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-2.0-flash"
