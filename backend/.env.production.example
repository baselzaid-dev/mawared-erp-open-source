# Self-hosted service configuration. Replace the reserved host with your own.
# Manage real values outside Git using your deployment secret store.
DATABASE_URL=
DIRECT_URL=
NODE_ENV=production
MAWARED_ENV=production
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=https://erp.example.invalid
JWT_SECRET=
PLATFORM_JWT_SECRET=
MFA_ENCRYPTION_KEY=
# Set to 1 only when every client connection traverses one trusted proxy.
TRUST_PROXY_HOPS=0
