# Mawared backend — PRODUCTION env template (placeholders ONLY — never commit
# a real .env.production; set these in the hosting provider's secret manager)

NODE_ENV=production
PORT=3000

# PostgreSQL (Supabase): pooled URL for the app, direct URL for migrations/backups
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Generate a NEW strong random value for production (e.g. `openssl rand -base64 48`).
# Never reuse the development value.
JWT_SECRET="CHANGE_ME_STRONG_RANDOM_VALUE"

# Token lifetimes (safe defaults)
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"

# Login/refresh rate limiting
AUTH_RATE_LIMIT_WINDOW_MS="900000"
AUTH_RATE_LIMIT_MAX="10"

# Browsers allowed to call the API (REAL production domains only; empty = deny all browsers)
CORS_ORIGINS="https://app.example.com"

# Credential recovery E1 (lazy; required only when recovery service is constructed).
# Never reuse JWT_SECRET / PLATFORM_JWT_SECRET / MFA_ENCRYPTION_KEY.
# CREDENTIAL_RECOVERY_TOKEN_PEPPER="CHANGE_ME_STRONG_RANDOM_RECOVERY_TOKEN_PEPPER"
# CREDENTIAL_RECOVERY_RATE_LIMIT_PEPPER="CHANGE_ME_STRONG_RANDOM_RECOVERY_RATE_LIMIT_PEPPER"
# CREDENTIAL_RECOVERY_ENVIRONMENT_BINDING="production:<approved-fingerprint>"

# Credential recovery E6 transactional email (commented placeholders only).
# Enter real values only in the hosting provider's protected secret manager.
# RECOVERY_EMAIL_API_BASE_URL=""
# RECOVERY_EMAIL_API_KEY=""
# RECOVERY_EMAIL_FROM_ADDRESS=""
# RECOVERY_EMAIL_TIMEOUT_MS=""
# RECOVERY_EMAIL_DEFAULT_LOCALE=""
# RECOVERY_PLATFORM_CONSOLE_BASE_URL=""
# RECOVERY_COMPANY_OWNER_LINK_BASE_URL=""
# RECOVERY_EMAIL_ALLOWED_HOSTS=""
# RECOVERY_EMAIL_REQUIRE_PROVIDER=""

# Optional — server-side ONLY. Never ships in the Android APK.
# GEMINI_API_KEY="..."
# GEMINI_MODEL="gemini-2.0-flash"
