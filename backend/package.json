{
  "name": "mawared-erp-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "prisma generate && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "node --import tsx scripts/run_postgres_suites.ts",
    "seed": "node --import tsx prisma/seed.ts",
    "bootstrap:platform-local": "node --import tsx scripts/bootstrap_platform_principal.ts",
    "db:migrate": "node scripts/migrate-local.mjs",
    "test:local-db-guard": "node --test scripts/local-database.test.mjs"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "8.2.0",
    "jsonwebtoken": "^9.0.3",
    "otpauth": "^9.5.1",
    "pdfkit": "^0.19.1",
    "prisma": "^5.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.2",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.2.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "brace-expansion": "5.0.12",
    "ip-address": "10.7.6",
    "postcss": "8.5.23",
    "protobufjs": "7.6.5",
    "exceljs": {
      "unzipper": "0.12.5",
      "minimatch": "11.0.5",
      "uuid": "11.1.1"
    },
    "qs": "6.16.2"
  }
}
