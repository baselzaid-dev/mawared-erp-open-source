// ---------------------------------------------------------------------------
// Commercial Wave 2 — Operations Slice E1 (purchasing lifecycle expansion)
//
// Design notes that the rest of the code depends on:
//  * Quantities are DECIMAL(18,3) and are only ever computed with integer
//    milli-units (BigInt) — never IEEE floats.
//  * Money is DECIMAL(18,2) and is only ever computed with integer cents.
//  * Receipts and returns are immutable *events*. "Received to date",
//    "returned to date", "net received" and "remaining receivable" are always
//    derived by summing those events inside a transaction that holds the
//    parent PurchaseOrder row lock. No cumulative column is mutated in place,
//    so receipt history is never destructively overwritten.
// ---------------------------------------------------------------------------

/// A supplier's priced offer against a Purchase Request.
/// `draft`/`submitted` are editable; `selected`/`rejected` are immutable
/// historical facts kept for comparison history.
model SupplierQuotation {
  id                 String    @id @default(uuid())
  companyId          String
  quotationNumber    String
  purchaseRequestId  String
  vendorId           String
  vendorNameSnapshot String
  /// The supplier's own document reference, as supplied by an authorized user.
  supplierReference  String?
  status             String    @default("draft") // draft, submitted, selected, rejected
  version            Int       @default(1)
  currency           String    @default("SAR") @db.Char(3)
  subtotal           Decimal   @db.Decimal(18, 2)
  totalAmount        Decimal   @db.Decimal(18, 2)
  quotationDate      DateTime? @db.Date
  validUntilDate     DateTime? @db.Date
  expectedDeliveryDate DateTime? @db.Date
  leadTimeDays       Int?
  paymentTerms       String?
  notes              String?
  createdByUserId    String
  submittedAt        DateTime? @db.Timestamptz(3)
  selectedByUserId   String?
  selectedAt         DateTime? @db.Timestamptz(3)
  selectionReason    String?
  rejectedByUserId   String?
  rejectedAt         DateTime? @db.Timestamptz(3)
  rejectionReason    String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  purchaseRequest PurchaseRequest         @relation(fields: [purchaseRequestId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  vendor          Vendor                  @relation(fields: [vendorId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User                    @relation("SupplierQuotationCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  selectedBy      User?                   @relation("SupplierQuotationSelector", fields: [selectedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  rejectedBy      User?                   @relation("SupplierQuotationRejecter", fields: [rejectedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  lines           SupplierQuotationLine[]
  orders          PurchaseOrder[]

  @@unique([id, companyId])
  @@unique([companyId, quotationNumber])
  @@index([companyId, purchaseRequestId, status])
  @@index([companyId, vendorId, status])
  @@index([companyId, status, createdAt])
}

model SupplierQuotationLine {
  id                  String   @id @default(uuid())
  companyId           String
  supplierQuotationId String
  requestLineId       String?
  descriptionSnapshot String
  categorySnapshot    String?
  quantity            Decimal  @db.Decimal(18, 3)
  unitSnapshot        String
  unitPrice           Decimal  @db.Decimal(18, 2)
  lineTotal           Decimal  @db.Decimal(18, 2)
  leadTimeDays        Int?
  notes               String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quotation   SupplierQuotation    @relation(fields: [supplierQuotationId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  requestLine PurchaseRequestLine? @relation(fields: [requestLineId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, companyId])
  @@index([companyId, supplierQuotationId])
  @@index([companyId, requestLineId])
}

/// One immutable goods-receipt event against a Purchase Order.
/// The legacy whole-order receive endpoint also creates exactly one of these,
/// covering every remaining quantity, so history stays complete.
model PurchaseReceipt {
  id                 String   @id @default(uuid())
  companyId          String
  purchaseOrderId    String
  receiptNumber      String
  /// full = legacy whole-order receive, partial = line-level receive.
  receiptKind        String   @default("partial")
  /// Delivery-note / waybill reference supplied by an authorized user.
  referenceNumber    String?
  note               String?
  receivedByUserId   String
  receivedAt         DateTime @default(now()) @db.Timestamptz(3)
  /// True only when purchasing.admin_override authorized an explicit over-receipt.
  overrideApplied    Boolean  @default(false)
  overrideReason     String?
  /// Client Idempotency-Key, unique per company.
  idempotencyKey     String
  /// SHA-256 of the canonical request payload; a same-key different-payload retry is a 409.
  payloadFingerprint String
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  receivedBy    User                  @relation("PurchaseReceiptRecorder", fields: [receivedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  lines         PurchaseReceiptLine[]

  @@unique([id, companyId])
  @@unique([companyId, receiptNumber])
  @@unique([companyId, idempotencyKey], map: "PurchaseReceipt_companyId_idempotencyKey_key")
  @@index([companyId, purchaseOrderId, receivedAt])
}

model PurchaseReceiptLine {
  id                  String   @id @default(uuid())
  companyId           String
  purchaseReceiptId   String
  purchaseOrderLineId String
  quantity            Decimal  @db.Decimal(18, 3)
  note                String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receipt   PurchaseReceipt   @relation(fields: [purchaseReceiptId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  orderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, companyId])
  @@index([companyId, purchaseReceiptId])
  @@index([companyId, purchaseOrderLineId])
}

/// A supplier return raised against quantities that were actually received.
/// `pending_approval` and `approved` returns both hold their quantity against
/// the order line, so two concurrent returns can never over-return.
/// A `rejected` return releases its quantity; receipt history is never erased.
model PurchaseReturn {
  id                 String    @id @default(uuid())
  companyId          String
  purchaseOrderId    String
  returnNumber       String
  status             String    @default("pending_approval") // pending_approval, approved, rejected
  /// Bounded reason category — never free text in audit metadata.
  reasonCode         String
  note               String?
  createdByUserId    String
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  reviewedByUserId   String?
  reviewedAt         DateTime? @db.Timestamptz(3)
  reviewNote         String?
  /// Client Idempotency-Key, unique per company.
  idempotencyKey     String
  payloadFingerprint String
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  createdBy     User                 @relation("PurchaseReturnCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy    User?                @relation("PurchaseReturnReviewer", fields: [reviewedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  lines         PurchaseReturnLine[]

  @@unique([id, companyId])
  @@unique([companyId, returnNumber])
  @@unique([companyId, idempotencyKey], map: "PurchaseReturn_companyId_idempotencyKey_key")
  @@index([companyId, purchaseOrderId, status])
}

model PurchaseReturnLine {
  id                  String   @id @default(uuid())
  companyId           String
  purchaseReturnId    String
  purchaseOrderLineId String
  quantity            Decimal  @db.Decimal(18, 3)
  note                String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  orderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, companyId])
  @@index([companyId, purchaseReturnId])
  @@index([companyId, purchaseOrderLineId])
}

model TrainingCourse {
