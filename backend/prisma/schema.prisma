// Finance foundation (Commercial W1A)
model ChartOfAccount {
  id               String    @id @default(uuid())
  companyId        String
  code             String
  name             String
  type             String // Asset, Liability, Equity, Revenue, Expense
  parentId         String?
  status           String    @default("active") // active, archived
  archivedAt       DateTime? @db.Timestamptz(3)
  archivedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent       ChartOfAccount?    @relation("ChartOfAccountHierarchy", fields: [parentId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  children     ChartOfAccount[]   @relation("ChartOfAccountHierarchy")
  archivedBy   User?              @relation("ChartOfAccountArchiver", fields: [archivedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  journalLines JournalEntryLine[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, parentId])
  @@index([companyId, type])
}

model CostCenter {
