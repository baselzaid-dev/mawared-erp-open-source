/// P4 — internal completion record for a finished training assignment.
/// Snapshots are frozen at issue time so a later course/employee edit cannot
/// retroactively change an already-issued certificate. Issue-only by design:
/// revocation is deliberately not modelled (see the P4 deferred-decisions list).
/// This is an internal company record and carries no external accreditation.
model TrainingCertificate {
  id                   String   @id @default(uuid())
  companyId            String
  assignmentId         String
  courseId             String
  employeeId           String
  serialNumber         String
  courseTitleSnapshot  String
  employeeNameSnapshot String
  employeeNumSnapshot  String
  completedAtSnapshot  DateTime @db.Timestamptz(3)
  issuedByUserId       String
  issuedAt             DateTime @default(now()) @db.Timestamptz(3)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignment TrainingAssignment @relation(fields: [assignmentId, companyId], references: [id, companyId], onDelete: Restrict)
  course     TrainingCourse     @relation(fields: [courseId, companyId], references: [id, companyId], onDelete: Restrict)
  employee   Employee           @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  issuedBy   User               @relation("TrainingCertificateIssuer", fields: [issuedByUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  // One certificate per assignment. The composite FK to (id, companyId) means a
  // second row under a different company could never resolve, so this is exact.
  @@unique([assignmentId, companyId])
  @@unique([companyId, serialNumber])
  @@index([companyId, employeeId, issuedAt])
  @@index([companyId, courseId])
  @@index([issuedByUserId])
}

/// P4 — reviewer-authored assessment of a completed training assignment.
/// Performance-adjacent: reading it needs `training.evaluation.view`, so it is
/// never company-wide-visible the way a course listing is. Scores are bounded
/// small integers and never enter audit payloads.
model TrainingEvaluation {
  id                String   @id @default(uuid())
  companyId         String
  assignmentId      String
  courseId          String
  employeeId        String
  effectivenessScore Int
  knowledgeScore    Int
  applicationScore  Int
  recommendation    String
  comment           String?
  evaluatedByUserId String
  evaluatedAt       DateTime @default(now()) @db.Timestamptz(3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignment  TrainingAssignment @relation(fields: [assignmentId, companyId], references: [id, companyId], onDelete: Restrict)
  course      TrainingCourse     @relation(fields: [courseId, companyId], references: [id, companyId], onDelete: Restrict)
  employee    Employee           @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  evaluatedBy User               @relation("TrainingEvaluationEvaluator", fields: [evaluatedByUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  // One evaluation per assignment (same composite-FK reasoning as the certificate).
  @@unique([assignmentId, companyId])
  @@index([companyId, employeeId, evaluatedAt])
  @@index([companyId, courseId])
  @@index([evaluatedByUserId])
}

