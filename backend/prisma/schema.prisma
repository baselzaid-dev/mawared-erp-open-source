  createdBy       User                @relation("PurchaseOrderCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict)
  issuedBy        User?               @relation("PurchaseOrderIssuer", fields: [issuedByUserId, companyId], references: [id, companyId], onDelete: Restrict)
