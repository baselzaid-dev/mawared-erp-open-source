}

model PayrollPeriod {
  id                     String    @id @default(uuid())
  companyId              String
  month                  Int
  year                   Int
  status                 String    @default("draft") // draft, calculated, approved, paid
  createdByUserId        String?
  calculatedByUserId     String?
  approvedByUserId       String?
  paidByUserId           String?
  calculatedAt           DateTime?
  approvedAt             DateTime?
  paidAt                 DateTime?
  calculationVersion     Int       @default(0)
  calculationFingerprint String?
  /// Optimistic concurrency for payment ledger record/void.
  paymentVersion         Int       @default(0)
  reopenedByUserId       String?
  reopenedAt             DateTime? @db.Timestamptz(3)
  reopenReason           String?
  ledgerPostedAt         DateTime? @db.Timestamptz(3)
