generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id        String   @id @default(uuid())
  code      String   @unique(map: "Company_code_key")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                       User[]
  employees                   Employee[]
  departments                 Department[]
  roles                       Role[]
  leaveRequests               LeaveRequest[]
  attendances                 Attendance[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  chartOfAccounts             ChartOfAccount[]
  costCenters                 CostCenter[]
  journalEntries              JournalEntry[]
  journalEntryLines           JournalEntryLine[]
  payrollLedgerPostings       PayrollLedgerPosting[]
  payrollComponentDefinitions PayrollComponentDefinition[]
  payrollItemComponentLines   PayrollItemComponentLine[]
  payrollItemAdjustments      PayrollItemAdjustment[]
  leaveApprovalHistory        LeaveApprovalHistory[]
  salaryRecords               SalaryRecord[]
  payrollPeriods              PayrollPeriod[]
  payrollItems                PayrollItem[]
  payrollPayments             PayrollPayment[]
  tasks                       Task[]
  taskAssignments             TaskAssignment[]
  taskComments                TaskComment[]
  chatConversations           ChatConversation[]
  chatParticipants            ChatParticipant[]
  chatMessages                ChatMessage[]
  chatPinnedMessages          ChatPinnedMessage[]
  vendors                     Vendor[]
  purchaseRequests            PurchaseRequest[]
  purchaseRequestLines        PurchaseRequestLine[]
  purchaseOrders              PurchaseOrder[]
  purchaseOrderLines          PurchaseOrderLine[]
  trainingCourses             TrainingCourse[]
  trainingResources           TrainingResource[]
  trainingAssignments         TrainingAssignment[]
  trainingCertificates        TrainingCertificate[]
  trainingEvaluations         TrainingEvaluation[]
  loginIdentities             LoginIdentity[]
  ownerships                  CompanyOwnership[]
  ownershipTransfers          OwnershipTransfer[]
  departmentManagers          DepartmentManager[]
  accessGrants                AccessGrant[]
  temporaryDelegations        TemporaryDelegation[]
  attachments                 Attachment[]
  delegationCapabilities      DelegationCapability[]
  permissionChangeBatches     PermissionChangeBatch[]
  permissionChangeHistory     PermissionChangeHistory[]
  notificationPreferences     NotificationPreference[]
  attendanceExemptions        AttendanceExemption[]
  attendanceCorrections       AttendanceCorrection[]
  attendanceCorrectionHistory AttendanceCorrectionHistory[]
  purchaseWorkflowEvents      PurchaseWorkflowEvent[]
  supplierQuotations          SupplierQuotation[]
  supplierQuotationLines      SupplierQuotationLine[]
  purchaseReceipts            PurchaseReceipt[]
  purchaseReceiptLines        PurchaseReceiptLine[]
  purchaseReturns             PurchaseReturn[]
  purchaseReturnLines         PurchaseReturnLine[]
  savedReportTemplates              SavedReportTemplate[]
  platformAuditLogs                 PlatformAuditLog[]
  platformIdempotencyKeys           PlatformIdempotencyKey[]
  credentialRecoveryRequests        CredentialRecoveryRequest[]
  credentialRecoveryAuditEvents     CredentialRecoveryAuditEvent[]
}

model PlatformPrincipal {
  id                   String    @id @default(uuid())
  email                String
  normalizedEmail      String    @unique(map: "PlatformPrincipal_normalizedEmail_key")
  password             String
  name                 String
  status               String    @default("active")
  permissions          String    @default("[]")
  authorizationVersion Int       @default(1)
  credentialVersion    Int       @default(1)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  refreshTokens                PlatformRefreshToken[]
  mfaCredential                PlatformMfaCredential?
  auditLogs                    PlatformAuditLog[]
  idempotencyKeys              PlatformIdempotencyKey[]
  ownershipsCreated            CompanyOwnership[]     @relation("CompanyOwnershipPlatformCreator")
  attendanceExemptionsCreated  AttendanceExemption[]  @relation("ExemptionPlatformCreator")

  @@index([status], map: "idx_PlatformPrincipal_status")
}

model PlatformRefreshToken {
  id                String    @id @default(uuid())
  sessionId         String    @unique
  principalId       String
  tokenHash         String    @unique
  expiresAt         DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  revokedReason     String?
  credentialVersion Int
  mfaVerifiedAt     DateTime  @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  principal PlatformPrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([principalId, revokedAt], map: "idx_PlatformRefreshToken_principal_revoked")
}

model PlatformMfaCredential {
  principalId             String    @id
  state                   String    @default("pending")
  secretCiphertext        String?
  pendingSecretCiphertext String?
  challengeTokenHash      String?   @unique
  challengePurpose        String?
  challengeExpiresAt      DateTime? @db.Timestamptz(3)
  challengeAttempts       Int       @default(0)
  failedAttempts          Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)
  backupCodeHashes        String    @default("[]")
  enrolledAt              DateTime? @db.Timestamptz(3)
  lastVerifiedAt          DateTime? @db.Timestamptz(3)
  lastUsedTimeStep        BigInt?
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)

  principal PlatformPrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([challengeExpiresAt], map: "idx_PlatformMfaCredential_challenge_expiry")
  @@index([lockedUntil], map: "idx_PlatformMfaCredential_locked_until")
}

model PlatformAuditLog {
  id              String   @id @default(uuid())
  principalId     String
  action          String
  details         String
  targetCompanyId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  principal   PlatformPrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetCompany Company?        @relation(fields: [targetCompanyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([principalId, createdAt], map: "idx_PlatformAuditLog_principal_created")
  @@index([targetCompanyId, createdAt], map: "idx_PlatformAuditLog_company_created")
}

model PlatformIdempotencyKey {
  id          String   @id @default(uuid())
  principalId String
  key         String
  requestHash String
  companyId   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  principal PlatformPrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company   Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([principalId, key], map: "PlatformIdempotencyKey_principal_key_key")
  @@index([companyId], map: "idx_PlatformIdempotencyKey_company")
}

model User {
  id                         String    @id @default(uuid())
  companyId                  String
  employeeId                 String?   @unique
  email                      String
  normalizedEmail            String
  password                   String
  name                       String
  roleId                     String
  authorizationVersion       Int       @default(1)
  accountStatus              String    @default("active") // active, disabled, archived
  mustChangePassword         Boolean   @default(false)
  temporaryPasswordExpiresAt DateTime? @db.Timestamptz(3)
  passwordChangedAt          DateTime? @db.Timestamptz(3)
  credentialVersion          Int       @default(1)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  role     Role      @relation(fields: [roleId], references: [id])

  managedDepartments                 Department[]                  @relation("LegacyDepartmentManager")
  notifications                      Notification[]
  auditLogs                          AuditLog[]
  leaveApprovalHistory               LeaveApprovalHistory[]
  refreshTokens                      RefreshToken[]
  mfaCredential                     UserMfaCredential?
  salaryRecordsCreated               SalaryRecord[]                @relation("SalaryRecordCreator")
  payrollPeriodsCreated              PayrollPeriod[]               @relation("PayrollPeriodCreator")
  payrollPeriodsCalculated           PayrollPeriod[]               @relation("PayrollPeriodCalculator")
  payrollPeriodsApproved             PayrollPeriod[]               @relation("PayrollPeriodApprover")
  payrollPeriodsPaid                 PayrollPeriod[]               @relation("PayrollPeriodPayer")
  payrollPeriodsReopened             PayrollPeriod[]               @relation("PayrollPeriodReopener")
  payrollPaymentsRecorded            PayrollPayment[]              @relation("PayrollPaymentRecorder")
  payrollPaymentsVoided              PayrollPayment[]              @relation("PayrollPaymentVoider")
  chartOfAccountsArchived            ChartOfAccount[]              @relation("ChartOfAccountArchiver")
  costCentersArchived                CostCenter[]                  @relation("CostCenterArchiver")
  journalEntriesCreated              JournalEntry[]                @relation("JournalEntryCreator")
  journalEntriesPosted               JournalEntry[]                @relation("JournalEntryPoster")
  journalEntriesReversed             JournalEntry[]                @relation("JournalEntryReverser")
  payrollLedgerPostingsPosted        PayrollLedgerPosting[]        @relation("PayrollLedgerPostingPoster")
  payrollComponentDefinitionsCreated PayrollComponentDefinition[]  @relation("PayrollComponentDefinitionCreator")
  payrollComponentDefinitionsArchived PayrollComponentDefinition[] @relation("PayrollComponentDefinitionArchiver")
  payrollItemAdjustmentsCreated      PayrollItemAdjustment[]       @relation("PayrollItemAdjustmentCreator")
  tasksCreated                       Task[]                        @relation("TaskCreator")
  taskAssignmentsReviewed            TaskAssignment[]              @relation("TaskAssignmentReviewer")
  taskCommentsAuthored               TaskComment[]                 @relation("TaskCommentAuthor")
  chatConversationsCreated           ChatConversation[]            @relation("ChatConversationCreator")
  chatParticipants                   ChatParticipant[]
  chatMessagesSent                   ChatMessage[]                 @relation("ChatMessageSender")
  chatPinnedMessages                 ChatPinnedMessage[]           @relation("ChatPinnedMessagePinner")
  attachmentsUploaded                Attachment[]                  @relation("AttachmentUploader")
  vendorsCreated                     Vendor[]                      @relation("VendorCreator")
  purchaseRequestsDeptReviewed       PurchaseRequest[]             @relation("PurchaseRequestDepartmentReviewer")
  purchaseRequestsPurchasingReviewed PurchaseRequest[]             @relation("PurchaseRequestPurchasingReviewer")
  purchaseRequestsCancelled          PurchaseRequest[]             @relation("PurchaseRequestCanceller")
  purchaseOrdersCreated              PurchaseOrder[]               @relation("PurchaseOrderCreator")
  purchaseOrdersIssued               PurchaseOrder[]               @relation("PurchaseOrderIssuer")
  purchaseOrdersReceived             PurchaseOrder[]               @relation("PurchaseOrderReceiver")
  purchaseOrdersCancelled            PurchaseOrder[]               @relation("PurchaseOrderCanceller")
  trainingCoursesCreated             TrainingCourse[]              @relation("TrainingCourseCreator")
  trainingCoursesPublished           TrainingCourse[]              @relation("TrainingCoursePublisher")
  trainingCoursesCompleted           TrainingCourse[]              @relation("TrainingCourseCompleter")
  trainingCoursesCancelled           TrainingCourse[]              @relation("TrainingCourseCanceller")
  trainingCoursesArchived            TrainingCourse[]              @relation("TrainingCourseArchiver")
  trainingAssignmentsAssigned        TrainingAssignment[]          @relation("TrainingAssignmentAssigner")
  trainingAssignmentsReviewed        TrainingAssignment[]          @relation("TrainingAssignmentReviewer")
  trainingAssignmentsCancelled       TrainingAssignment[]          @relation("TrainingAssignmentCanceller")
  trainingCertificatesIssued         TrainingCertificate[]         @relation("TrainingCertificateIssuer")
  trainingEvaluationsMade            TrainingEvaluation[]          @relation("TrainingEvaluationEvaluator")
  loginIdentities                    LoginIdentity[]
  ownerships                         CompanyOwnership[]            @relation("CompanyOwnershipUser")
  ownershipsCreated                  CompanyOwnership[]            @relation("CompanyOwnershipCreator")
  ownershipsEnded                    CompanyOwnership[]            @relation("CompanyOwnershipEnder")
  ownershipTransfersFrom             OwnershipTransfer[]           @relation("OwnershipTransferFrom")
  ownershipTransfersTo               OwnershipTransfer[]           @relation("OwnershipTransferTo")
  ownershipTransfersPerformed        OwnershipTransfer[]           @relation("OwnershipTransferActor")
  departmentManagerMemberships       DepartmentManager[]           @relation("DepartmentManagerUser")
  departmentManagerAssignmentsMade   DepartmentManager[]           @relation("DepartmentManagerAssigner")
  departmentManagerAssignmentsEnded  DepartmentManager[]           @relation("DepartmentManagerEnder")
  accessGrantsReceived               AccessGrant[]                 @relation("AccessGrantRecipient")
  accessGrantsCreated                AccessGrant[]                 @relation("AccessGrantGrantor")
  accessGrantsRevoked                AccessGrant[]                 @relation("AccessGrantRevoker")
  delegationsGiven                   TemporaryDelegation[]         @relation("DelegationDelegator")
  delegationsReceived                TemporaryDelegation[]         @relation("DelegationRecipient")
  delegationsRevoked                 TemporaryDelegation[]         @relation("DelegationRevoker")
  permissionChangeBatchesTargeted    PermissionChangeBatch[]       @relation("PermissionBatchTarget")
  permissionChangeBatchesPerformed   PermissionChangeBatch[]       @relation("PermissionBatchActor")
  permissionChangesTargeted          PermissionChangeHistory[]     @relation("PermissionHistoryTarget")
  permissionChangesPerformed         PermissionChangeHistory[]     @relation("PermissionHistoryActor")
  notificationPreferences            NotificationPreference[]
  attendanceExemptions               AttendanceExemption[]         @relation("ExemptionUser")
  attendanceExemptionsCreated        AttendanceExemption[]         @relation("ExemptionCreator")
  attendanceExemptionsRevoked        AttendanceExemption[]         @relation("ExemptionRevoker")
  attendanceCorrectionsRequested     AttendanceCorrection[]        @relation("CorrectionRequester")
  attendanceCorrectionsReviewed      AttendanceCorrection[]        @relation("CorrectionReviewer")
  attendanceCorrectionHistoryActions AttendanceCorrectionHistory[] @relation("CorrectionHistoryActor")
  leaveRequestsSubmitted             LeaveRequest[]                @relation("LeaveSubmitter")
  employeesArchived                  Employee[]                    @relation("EmployeeArchiver")
  vendorsArchived                    Vendor[]                      @relation("VendorArchiver")
  purchaseWorkflowEvents             PurchaseWorkflowEvent[]       @relation("PurchaseWorkflowEventActor")
  supplierQuotationsCreated          SupplierQuotation[]           @relation("SupplierQuotationCreator")
  supplierQuotationsSelected         SupplierQuotation[]           @relation("SupplierQuotationSelector")
  supplierQuotationsRejected         SupplierQuotation[]           @relation("SupplierQuotationRejecter")
  purchaseReceiptsRecorded           PurchaseReceipt[]             @relation("PurchaseReceiptRecorder")
  purchaseReturnsCreated             PurchaseReturn[]              @relation("PurchaseReturnCreator")
  purchaseReturnsReviewed            PurchaseReturn[]              @relation("PurchaseReturnReviewer")
  savedReportTemplates               SavedReportTemplate[]         @relation("SavedReportTemplateOwner")

  @@unique([id, companyId])
  @@unique([companyId, normalizedEmail], map: "User_companyId_normalizedEmail_key")
  @@index([companyId], map: "idx_User_companyId")
  @@index([roleId], map: "idx_User_roleId")
  @@index([companyId, accountStatus], map: "idx_User_company_accountStatus")
}

// Refresh tokens are stored ONLY as a SHA-256 hash — never plaintext.
// Rotation: each successful /api/auth/refresh revokes the used token and
// issues a new one. Logout revokes the presented token.
// sessionId is the public session identifier shown in session lists (never the raw token).
model RefreshToken {
  id                String    @id @default(uuid())
  sessionId         String    @unique
  userId            String
  companyId         String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  deviceLabel       String?
  platform          String?
  lastUsedAt        DateTime? @db.Timestamptz(3)
  bindingHash       String?
  credentialVersion Int       @default(1)
  revokedReason     String?

  user User @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@index([companyId, userId, revokedAt], map: "idx_RefreshToken_company_user_revoked")
  @@index([userId, lastUsedAt], map: "idx_RefreshToken_user_lastUsedAt")
}

model UserMfaCredential {
  userId                  String    @id
  companyId               String
  state                   String    @default("pending") // pending, enrolled
  secretCiphertext        String?
  pendingSecretCiphertext String?
  challengeTokenHash      String?   @unique
  challengePurpose        String?
  challengeExpiresAt      DateTime? @db.Timestamptz(3)
  challengeAttempts       Int       @default(0)
  failedAttempts          Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)
  backupCodeHashes        String    @default("[]")
  enrolledAt              DateTime? @db.Timestamptz(3)
  lastVerifiedAt          DateTime? @db.Timestamptz(3)
  lastUsedTimeStep        BigInt?
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, state], map: "idx_UserMfaCredential_company_state")
  @@index([challengeExpiresAt], map: "idx_UserMfaCredential_challenge_expiry")
  @@index([lockedUntil], map: "idx_UserMfaCredential_locked_until")
}

model Employee {
  id                    String    @id @default(uuid())
  companyId             String
  employeeNum           String
  normalizedEmployeeNum String
  jobTitle              String
  joiningDate           DateTime
  status                String    @default("active") // active, inactive, terminated
  contactInfo           String?
  departmentId          String?
  archivedAt            DateTime? @db.Timestamptz(3)
  archivedByUserId      String?
  archiveReason         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                  User?
  archivedBy            User?                  @relation("EmployeeArchiver", fields: [archivedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  department            Department?            @relation(fields: [departmentId], references: [id])
  attendances           Attendance[]
  leaveRequests         LeaveRequest[]         @relation("Requester")
  leavesApproved        LeaveRequest[]         @relation("Approver")
  salaryRecords         SalaryRecord[]
  payrollItems          PayrollItem[]
  payrollComponentLines PayrollItemComponentLine[]
  payrollAdjustments    PayrollItemAdjustment[]
  taskAssignments       TaskAssignment[]
  purchaseRequests      PurchaseRequest[]
  trainingAssignments   TrainingAssignment[]
  trainingCertificates  TrainingCertificate[]
  trainingEvaluations   TrainingEvaluation[]
  attendanceExemptions  AttendanceExemption[]
  attendanceCorrections AttendanceCorrection[]

  @@unique([id, companyId])
  @@unique([companyId, normalizedEmployeeNum], map: "Employee_companyId_normalizedEmployeeNum_key")
  @@index([companyId], map: "idx_Employee_companyId")
  @@index([departmentId], map: "idx_Employee_departmentId")
  @@index([companyId, archivedAt], map: "idx_Employee_company_archivedAt")
}

model LoginIdentity {
  id                   String   @id @default(uuid())
  companyId            String
  userId               String
  type                 String
  normalizedIdentifier String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user    User    @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, normalizedIdentifier], map: "LoginIdentity_companyId_normalizedIdentifier_key")
  @@unique([companyId, type, normalizedIdentifier], map: "LoginIdentity_companyId_type_normalizedIdentifier_key")
  @@unique([companyId, userId, type], map: "LoginIdentity_companyId_userId_type_key")
  @@index([userId, companyId], map: "idx_LoginIdentity_userId_companyId")
}

model Department {
  id        String   @id @default(uuid())
  companyId String
  name      String
  managerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company                 Company                   @relation(fields: [companyId], references: [id])
  manager                 User?                     @relation("LegacyDepartmentManager", fields: [managerId], references: [id])
  employees               Employee[]
  chatConversations       ChatConversation[]
  purchaseRequests        PurchaseRequest[]
  managerMemberships      DepartmentManager[]
  accessGrants            AccessGrant[]
  temporaryDelegations    TemporaryDelegation[]
  permissionChangeHistory PermissionChangeHistory[]

  @@unique([id, companyId])
}

model CompanyOwnership {
  id                     String    @id @default(uuid())
  companyId              String
  activePrimaryCompanyId String?   @unique(map: "CompanyOwnership_one_active_primary_key")
  userId                 String
  isPrimary              Boolean   @default(true)
  status                 String    @default("active")
  effectiveAt            DateTime  @default(now()) @db.Timestamptz(3)
  endedAt                DateTime? @db.Timestamptz(3)
  createdByUserId        String?
  createdByPlatformPrincipalId String?
  endedByUserId          String?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User    @relation("CompanyOwnershipUser", fields: [userId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  createdBy User?   @relation("CompanyOwnershipCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  createdByPlatform PlatformPrincipal? @relation("CompanyOwnershipPlatformCreator", fields: [createdByPlatformPrincipalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  endedBy   User?   @relation("CompanyOwnershipEnder", fields: [endedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, companyId])
  @@index([companyId, status, isPrimary], map: "idx_CompanyOwnership_company_status_primary")
  @@index([userId, companyId], map: "idx_CompanyOwnership_user_company")
  @@index([createdByUserId, companyId], map: "idx_CompanyOwnership_creator_company")
  @@index([createdByPlatformPrincipalId], map: "idx_CompanyOwnership_platform_creator")
  @@index([endedByUserId, companyId], map: "idx_CompanyOwnership_ender_company")
}

model OwnershipTransfer {
  id                  String   @id @default(uuid())
  companyId           String
  fromUserId          String
  toUserId            String
  reason              String
  transferredByUserId String
  idempotencyKey      String
  previewDigest       String
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  company       Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fromUser      User    @relation("OwnershipTransferFrom", fields: [fromUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  toUser        User    @relation("OwnershipTransferTo", fields: [toUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  transferredBy User    @relation("OwnershipTransferActor", fields: [transferredByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, transferredByUserId, idempotencyKey], map: "OwnershipTransfer_actor_idempotency_key")
  @@index([companyId, createdAt], map: "idx_OwnershipTransfer_company_created")
  @@index([fromUserId, companyId], map: "idx_OwnershipTransfer_from_company")
  @@index([toUserId, companyId], map: "idx_OwnershipTransfer_to_company")
}

model DepartmentManager {
  id               String    @id @default(uuid())
  companyId        String
  departmentId     String
  userId           String
  status           String    @default("active")
  assignedByUserId String
  assignedAt       DateTime  @default(now()) @db.Timestamptz(3)
  endedAt          DateTime? @db.Timestamptz(3)
  endedByUserId    String?

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department Department @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  user       User       @relation("DepartmentManagerUser", fields: [userId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  assignedBy User       @relation("DepartmentManagerAssigner", fields: [assignedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  endedBy    User?      @relation("DepartmentManagerEnder", fields: [endedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, companyId])
  @@index([companyId, departmentId, status], map: "idx_DepartmentManager_company_department_status")
  @@index([companyId, userId, status], map: "idx_DepartmentManager_company_user_status")
  @@index([assignedByUserId, companyId], map: "idx_DepartmentManager_assigner_company")
  @@index([endedByUserId, companyId], map: "idx_DepartmentManager_ender_company")
}

model AccessGrant {
  id              String    @id @default(uuid())
  companyId       String
  recipientUserId String
  capability      String
  scopeType       String
  departmentId    String?
  grantedByUserId String
  reason          String
  grantKind       String    @default("direct")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  revokedByUserId String?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipient  User        @relation("AccessGrantRecipient", fields: [recipientUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  grantedBy  User        @relation("AccessGrantGrantor", fields: [grantedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  revokedBy  User?       @relation("AccessGrantRevoker", fields: [revokedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  department Department? @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, companyId])
  @@index([companyId, recipientUserId, status], map: "idx_AccessGrant_company_recipient_status")
  @@index([companyId, capability, scopeType, status], map: "idx_AccessGrant_company_capability_scope_status")
  @@index([departmentId, companyId], map: "idx_AccessGrant_department_company")
  @@index([grantedByUserId, companyId], map: "idx_AccessGrant_grantor_company")
  @@index([revokedByUserId, companyId], map: "idx_AccessGrant_revoker_company")
}

model TemporaryDelegation {
  id              String    @id @default(uuid())
  companyId       String
  delegatorUserId String
  recipientUserId String
  scopeType       String
  departmentId    String?
  validFrom       DateTime  @db.Timestamptz(3)
  validUntil      DateTime  @db.Timestamptz(3)
  reason          String
  idempotencyKey  String
  status          String    @default("active")
  revokedAt       DateTime? @db.Timestamptz(3)
  revokedByUserId String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  company      Company                @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  delegator    User                   @relation("DelegationDelegator", fields: [delegatorUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  recipient    User                   @relation("DelegationRecipient", fields: [recipientUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  revokedBy    User?                  @relation("DelegationRevoker", fields: [revokedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  department   Department?            @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  capabilities DelegationCapability[]

  @@unique([id, companyId])
  @@unique([companyId, delegatorUserId, idempotencyKey], map: "TemporaryDelegation_delegator_idempotency_key")
  @@index([companyId, recipientUserId, status, validFrom, validUntil], map: "idx_TemporaryDelegation_recipient_effective")
  @@index([companyId, delegatorUserId, status], map: "idx_TemporaryDelegation_delegator_status")
  @@index([departmentId, companyId], map: "idx_TemporaryDelegation_department_company")
  @@index([revokedByUserId, companyId], map: "idx_TemporaryDelegation_revoker_company")
}

