  revokedAt       DateTime? @db.Timestamptz(3)
  version         Int       @default(1)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User      @relation("ExemptionUser", fields: [userId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  employee  Employee? @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  createdBy User?     @relation("ExemptionCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  createdByPlatform PlatformPrincipal? @relation("ExemptionPlatformCreator", fields: [createdByPlatformPrincipalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revokedBy User?     @relation("ExemptionRevoker", fields: [revokedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

