  payloadFingerprint String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor   User    @relation("PurchaseWorkflowEventActor", fields: [actorUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

