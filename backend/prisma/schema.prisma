  updatedAt              DateTime  @updatedAt

  company           Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy         User?                      @relation("PayrollPeriodCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  calculatedBy      User?                      @relation("PayrollPeriodCalculator", fields: [calculatedByUserId], references: [id], onDelete: Restrict)
  approvedBy        User?                      @relation("PayrollPeriodApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  paidBy            User?                      @relation("PayrollPeriodPayer", fields: [paidByUserId], references: [id], onDelete: Restrict)
  reopenedBy        User?                      @relation("PayrollPeriodReopener", fields: [reopenedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  items             PayrollItem[]
  payments          PayrollPayment[]
  componentLines    PayrollItemComponentLine[]
  adjustments       PayrollItemAdjustment[]
  ledgerPostings    PayrollLedgerPosting[]
  sourceJournalEntries JournalEntry[]          @relation("JournalEntryPayrollSource")

  @@unique([companyId, year, month])
  @@unique([id, companyId])
  @@index([companyId, status])
}

model PayrollPayment {
  id                String    @id @default(uuid())
  companyId         String
  payrollPeriodId   String
  amount            Decimal   @db.Decimal(18, 2)
  currency          String    @default("SAR") @db.Char(3)
  paymentDate       DateTime  @db.Date
  reference         String?
  note              String?
  status            String    @default("posted") // posted, voided
  idempotencyKey    String
  recordedByUserId  String
  createdAt         DateTime  @default(now())
  voidedAt          DateTime?
  voidedByUserId    String?
  voidReason        String?
  /// True only for M07 backfill of legacy paid periods — not a bank claim.
  isLegacyMigration Boolean   @default(false)

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId, companyId], references: [id, companyId], onDelete: Restrict)
  recordedBy    User          @relation("PayrollPaymentRecorder", fields: [recordedByUserId, companyId], references: [id, companyId], onDelete: Restrict)
  voidedBy      User?         @relation("PayrollPaymentVoider", fields: [voidedByUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([companyId, payrollPeriodId, idempotencyKey])
  @@unique([id, companyId])
  @@index([companyId, payrollPeriodId, createdAt])
  @@index([companyId, status, paymentDate])
}

model PayrollItem {
  id                     String   @id @default(uuid())
  companyId              String
  payrollPeriodId        String
  employeeId             String
  salaryRecordId         String
  employeeNameSnapshot   String
  employeeNumSnapshot    String
  departmentNameSnapshot String?
  baseSalary             Decimal  @db.Decimal(18, 2)
  grossPay               Decimal  @db.Decimal(18, 2)
  totalDeductions        Decimal  @db.Decimal(18, 2)
  netPay                 Decimal  @db.Decimal(18, 2)
  currency               String   @default("SAR") @db.Char(3)
  status                 String   @default("calculated")
  calculatedAt           DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company        Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payrollPeriod  PayrollPeriod              @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  employee       Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salaryRecord   SalaryRecord               @relation(fields: [salaryRecordId], references: [id], onDelete: Restrict)
  componentLines PayrollItemComponentLine[]
  adjustments    PayrollItemAdjustment[]

  @@unique([payrollPeriodId, employeeId])
  @@unique([id, companyId])
  @@index([companyId, payrollPeriodId])
  @@index([companyId, employeeId])
  @@index([companyId, status])
}

model Task {
  id              String    @id @default(uuid())
  companyId       String
  title           String
  description     String?
  priority        String    @default("normal") // low, normal, high, urgent
  dueDate         DateTime? @db.Date
  createdByUserId String
  status          String    @default("active") // active, completed, cancelled
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  creator     User             @relation("TaskCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict)
  assignments TaskAssignment[]
  comments    TaskComment[]
  attachments Attachment[]

  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([createdByUserId])
  @@index([dueDate])
}

/// P4 — task discussion thread. Visibility is derived from the parent task's
/// own department/assignment scope; a comment is never broader than its task.
model TaskComment {
  id           String   @id @default(uuid())
  companyId    String
  taskId       String
  authorUserId String
  body         String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  task    Task    @relation(fields: [taskId, companyId], references: [id, companyId], onDelete: Restrict)
  author  User    @relation("TaskCommentAuthor", fields: [authorUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  // Keyset pagination support, mirroring ChatMessage's (conversation, createdAt, id).
  @@index([companyId, taskId, createdAt, id])
  @@index([authorUserId])
}

model TaskAssignment {
  id                String    @id @default(uuid())
  companyId         String
  taskId            String
  employeeId        String
  status            String    @default("assigned") // assigned, in_progress, submitted, accepted, returned
  completionDetails String?
  submittedAt       DateTime?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  task     Task     @relation(fields: [taskId, companyId], references: [id, companyId], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  reviewer User?    @relation("TaskAssignmentReviewer", fields: [reviewedByUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([taskId, employeeId])
  @@index([companyId, employeeId, status])
  @@index([taskId])
}

model ChatConversation {
  id              String    @id @default(uuid())
  companyId       String
  type            String
  departmentId    String?
  directKey       String?
  title           String?
  repliesEnabled  Boolean   @default(false)
  createdByUserId String
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department   Department?        @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  creator      User               @relation("ChatConversationCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict)
  participants ChatParticipant[]
  messages     ChatMessage[]
  pins         ChatPinnedMessage[]

  @@unique([id, companyId])
  @@unique([companyId, directKey])
  @@unique([companyId, departmentId, type])
  @@index([companyId, type, lastMessageAt])
  @@index([departmentId])
  @@index([createdByUserId])
}

model ChatParticipant {
  id             String    @id @default(uuid())
  companyId      String
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  active         Boolean   @default(true)

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  conversation ChatConversation @relation(fields: [conversationId, companyId], references: [id, companyId], onDelete: Restrict)
  user         User             @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([companyId, userId, active])
  @@index([conversationId])
}

model ChatMessage {
  id               String   @id @default(uuid())
  companyId        String
  conversationId   String
  senderUserId     String
  body             String
  replyToMessageId String?
  createdAt        DateTime @default(now())

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  conversation ChatConversation   @relation(fields: [conversationId, companyId], references: [id, companyId], onDelete: Restrict)
  sender       User               @relation("ChatMessageSender", fields: [senderUserId, companyId], references: [id, companyId], onDelete: Restrict)
  replyTo      ChatMessage?       @relation("ChatMessageReply", fields: [replyToMessageId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  replies      ChatMessage[]      @relation("ChatMessageReply")
  pins         ChatPinnedMessage[]
  attachments  Attachment[]

  @@unique([id, companyId])
  @@index([conversationId, createdAt, id])
  @@index([companyId, conversationId])
  @@index([senderUserId])
  @@index([replyToMessageId])
}

model ChatPinnedMessage {
  id             String   @id @default(uuid())
  companyId      String
  conversationId String
  messageId      String
  pinnedByUserId String
  pinnedAt       DateTime @default(now())

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  conversation ChatConversation @relation(fields: [conversationId, companyId], references: [id, companyId], onDelete: Restrict)
  message      ChatMessage      @relation(fields: [messageId, companyId], references: [id, companyId], onDelete: Restrict)
  pinnedBy     User             @relation("ChatPinnedMessagePinner", fields: [pinnedByUserId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([conversationId, messageId])
  @@unique([id, companyId])
  @@index([companyId, conversationId, pinnedAt])
  @@index([messageId])
  @@index([pinnedByUserId])
}

// QA Round 1 — DB-backed attachments (bytea). Staging redeploy + migrate required.
model Attachment {
  id                String   @id @default(uuid())
  companyId         String
  storageBytes      Bytes
  originalFilename  String
  contentType       String
  byteSize          Int
  sha256            String
  uploadedByUserId  String
  purpose           String // chat | purchasing | task
  purchaseOrderId   String?
  chatMessageId     String?
  taskId            String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  uploadedBy     User           @relation("AttachmentUploader", fields: [uploadedByUserId, companyId], references: [id, companyId], onDelete: Restrict)
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId, companyId], references: [id, companyId], onDelete: Restrict)
  chatMessage    ChatMessage?   @relation(fields: [chatMessageId, companyId], references: [id, companyId], onDelete: Restrict)
  task           Task?          @relation(fields: [taskId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, purpose, createdAt])
  @@index([companyId, purchaseOrderId])
  @@index([companyId, chatMessageId])
  @@index([companyId, taskId])
  @@index([uploadedByUserId])
  @@index([sha256])
}

// Sprint 12J M09 — saved report template configuration only (never SQL / arbitrary joins).
model SavedReportTemplate {
  id              String    @id @default(uuid())
  companyId       String
  ownerUserId     String
  name            String
  builtInKey      String
  templateVersion Int
  scopeKind       String    @default("company")
  departmentId    String?
  filtersJson     Json
  preferredFormat String?
  archivedAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owner   User    @relation("SavedReportTemplateOwner", fields: [ownerUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, companyId])
  @@index([companyId, ownerUserId, archivedAt], map: "idx_SavedReportTemplate_owner")
  @@index([companyId, builtInKey], map: "idx_SavedReportTemplate_key")
}

/// E1 credential recovery challenge record.
/// principalId is polymorphic (PlatformPrincipal or User) and intentionally has no Prisma FK.
/// CHECK constraints in migration SQL enforce domain/purpose/company, token/hash shape,
/// environment binding, TTL ordering (expiresAt > createdAt), source-hash shape, and lifecycle.
/// E1 crypto is V1-only (hmac-sha256-v1); changing the recovery pepper invalidates outstanding digests.
model CredentialRecoveryRequest {
  id                          String    @id @default(uuid())
  principalDomain             String
  principalId                 String
  companyId                   String?
  purpose                     String
  tokenHash                   String?
  tokenHashAlgorithm          String?
  environmentBinding          String
  createdAt                   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt                   DateTime  @db.Timestamptz(3)
  consumedAt                  DateTime? @db.Timestamptz(3)
  supersededByRequestId       String?
  invalidatedAt               DateTime? @db.Timestamptz(3)
  invalidationReason          String?
  credentialVersionAtIssuance Int
  initiatedBy                 String
  initiatorPrincipalId        String?
  deliveryChannel             String
  deliveryStatus              String    @default("pending")
  /// Keyed recovery-src-v1:<64 hex> only — never raw identifiers.
  requestSourceHash           String?
  auditEventId                String?

  company       Company?                    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy  CredentialRecoveryRequest?  @relation("RecoverySupersession", fields: [supersededByRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersedes    CredentialRecoveryRequest[] @relation("RecoverySupersession")
  auditEvents   CredentialRecoveryAuditEvent[]

  @@index([principalDomain, principalId, purpose, createdAt], map: "idx_CredentialRecoveryRequest_principal_purpose")
  @@index([expiresAt], map: "idx_CredentialRecoveryRequest_expiry_cleanup")
  @@index([companyId, createdAt], map: "idx_CredentialRecoveryRequest_company_created")
  @@index([auditEventId], map: "idx_CredentialRecoveryRequest_audit_ref")
}

/// Fixed-column recovery audit evidence. No free-form secret-bearing JSON.
/// Unresolved subjects must keep subjectId/companyId null (enforced in SQL).
/// referenceId is the external-safe unique event reference.
model CredentialRecoveryAuditEvent {
  id                String   @id @default(uuid())
  eventType         String
  timestamp         DateTime @default(now()) @db.Timestamptz(3)
  actorType         String
  actorId           String?
  subjectId         String?
  subjectDomain     String
  companyId         String?
  result            String
  reasonCode        String
  recoveryRequestId String?
  requestId         String
  /// Keyed recovery-src-v1:<64 hex> only.
  sourceBucketHash  String?
  referenceId       String   @unique(map: "CredentialRecoveryAuditEvent_referenceId_key")

  company         Company?                   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recoveryRequest CredentialRecoveryRequest? @relation(fields: [recoveryRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([recoveryRequestId, timestamp], map: "idx_CredentialRecoveryAuditEvent_request")
  @@index([subjectDomain, subjectId, timestamp], map: "idx_CredentialRecoveryAuditEvent_subject")
  @@index([companyId, timestamp], map: "idx_CredentialRecoveryAuditEvent_company")
  @@index([requestId], map: "idx_CredentialRecoveryAuditEvent_requestId")
}

/// Durable recovery rate-limit counters. bucketKeyHash is keyed 64-hex only.
/// Application increments via atomic INSERT ... ON CONFLICT DO UPDATE.
model CredentialRecoveryRateLimitBucket {
  id              String    @id @default(uuid())
  surface         String
  dimension       String
  bucketKeyHash   String
  windowStartedAt DateTime  @db.Timestamptz(3)
  windowEndsAt    DateTime  @db.Timestamptz(3)
  count           Int       @default(0)
  alertedAt       DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([surface, dimension, bucketKeyHash, windowStartedAt], map: "CredentialRecoveryRateLimitBucket_unique")
  @@index([windowEndsAt], map: "idx_CredentialRecoveryRateLimitBucket_window")
}
