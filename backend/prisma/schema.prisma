  category           String?
  instructorName     String?
  deliveryMode       String    @default("onsite")
  location           String?
  startDate          DateTime? @db.Date
  endDate            DateTime? @db.Date
  durationHours      Int?
  capacity           Int?
  status             String    @default("draft")
  createdByUserId    String
  publishedByUserId  String?
  publishedAt        DateTime?
  completedByUserId  String?
  completedAt        DateTime?
  cancelledByUserId  String?
  cancelledAt        DateTime?
  cancellationReason String?
  archivedByUserId   String?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy   User                 @relation("TrainingCourseCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict)
  publishedBy User?                @relation("TrainingCoursePublisher", fields: [publishedByUserId, companyId], references: [id, companyId], onDelete: Restrict)
  completedBy User?                @relation("TrainingCourseCompleter", fields: [completedByUserId, companyId], references: [id, companyId], onDelete: Restrict)
  cancelledBy User?                @relation("TrainingCourseCanceller", fields: [cancelledByUserId, companyId], references: [id, companyId], onDelete: Restrict)
