  journalLines JournalEntryLine[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, status])
}

model JournalEntry {
  id                       String    @id @default(uuid())
  companyId                String
  status                   String    @default("draft") // draft, posted, reversed
  entryDate                DateTime  @db.Date
  reference                String?
  memo                     String?
  currency                 String    @default("SAR") @db.Char(3)
  totalDebit               Decimal   @db.Decimal(18, 2)
  totalCredit              Decimal   @db.Decimal(18, 2)
  postedAt                 DateTime? @db.Timestamptz(3)
  postedByUserId           String?
  reversedAt               DateTime? @db.Timestamptz(3)
  reversedByUserId         String?
  reversesJournalEntryId   String?
  idempotencyKey           String?
  sourceType               String? // manual, payroll
  sourcePayrollPeriodId    String?
  sourceCalculationVersion Int?
  createdByUserId          String
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy            User                  @relation("JournalEntryCreator", fields: [createdByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  postedBy             User?                 @relation("JournalEntryPoster", fields: [postedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  reversedBy           User?                 @relation("JournalEntryReverser", fields: [reversedByUserId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  reversesJournalEntry JournalEntry?         @relation("JournalEntryReversal", fields: [reversesJournalEntryId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  reversedByEntries    JournalEntry[]        @relation("JournalEntryReversal")
  sourcePayrollPeriod  PayrollPeriod?        @relation("JournalEntryPayrollSource", fields: [sourcePayrollPeriodId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  lines                JournalEntryLine[]
  payrollLedgerPosting PayrollLedgerPosting?

  @@unique([id, companyId])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status, entryDate])
  @@index([companyId, sourceType, sourcePayrollPeriodId])
  @@index([companyId, createdAt])
}

model JournalEntryLine {
  id             String  @id @default(uuid())
  companyId      String
