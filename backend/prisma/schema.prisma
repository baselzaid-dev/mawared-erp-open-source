model TrainingAssignment {
  id                     String    @id @default(uuid())
  companyId              String
  courseId               String
  employeeId             String
  employeeNameSnapshot   String
  employeeNumSnapshot    String
  departmentIdSnapshot   String?
  departmentNameSnapshot String?
  status                 String    @default("assigned")
  progressPercent        Int       @default(0)
  assignedByUserId       String
  assignedAt             DateTime  @default(now())
  startedAt              DateTime?
  submittedAt            DateTime?
  completionNote         String?
  completedAt            DateTime?
  reviewedByUserId       String?
  reviewedAt             DateTime?
  reviewNote             String?
  score                  Int?
  cancelledByUserId      String?
  cancelledAt            DateTime?
  cancellationReason     String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  course      TrainingCourse       @relation(fields: [courseId, companyId], references: [id, companyId], onDelete: Restrict)
  employee    Employee             @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  assignedBy  User                 @relation("TrainingAssignmentAssigner", fields: [assignedByUserId, companyId], references: [id, companyId], onDelete: Restrict)
  reviewedBy  User?                @relation("TrainingAssignmentReviewer", fields: [reviewedByUserId, companyId], references: [id, companyId], onDelete: Restrict)
  cancelledBy User?                @relation("TrainingAssignmentCanceller", fields: [cancelledByUserId, companyId], references: [id, companyId], onDelete: Restrict)
