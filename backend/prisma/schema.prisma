  exitReentryRequested Boolean @default(false)
  visaFeePaid          Boolean @default(false)

  // Tracking
  hrReviewerId      String?
  adminApproverId   String?
  rejectionReason   String?
  submittedByUserId String?
  submissionMode    String   @default("self") // self, on_behalf
  submissionReason  String?
